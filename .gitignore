# Môi trường ảo Python
.venv/
venv/
ENV/

# File biến môi trường chứa secret/cấu hình máy cá nhân
.env

# Cơ sở dữ liệu SQLite cục bộ
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
# Cache Python và Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Thư mục lưu trữ tài liệu tải lên (chỉ giữ file .gitkeep)
storage/*
!storage/.gitkeep

# Thư mục cấu hình IDE
.vscode/
.idea/
