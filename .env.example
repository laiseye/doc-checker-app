# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (Dự án Quản lý & Kiểm tra Hồ sơ điện tử)
# ==============================================================================
# Chuỗi kết nối Cơ sở dữ liệu (Mặc định dùng SQLite cục bộ)
# Đường dẫn ./app.db sẽ được backend tự động chuẩn hóa thành đường dẫn tuyệt đối
# từ thư mục gốc dự án để Alembic và Uvicorn luôn dùng chung một file DB.
DATABASE_URL=sqlite:///./app.db

# Danh sách domain được phép gọi API qua CORS (phân tách bởi dấu phẩy nếu nhiều domain)
CORS_ORIGINS=http://localhost:8000

# Thư mục lưu trữ tệp tin tải lên (tính tương đối từ thư mục gốc dự án)
STORAGE_DIR=storage

# Giới hạn dung lượng tải lên tối đa cho mỗi tệp tin (Megabytes)
MAX_UPLOAD_MB=20

# Ngưỡng ký tự tối thiểu mỗi trang PDF (sau khi strip). Nếu dưới ngưỡng này sẽ đánh dấu needs_ocr
PARSER_MIN_CHARS_PER_PAGE=20
